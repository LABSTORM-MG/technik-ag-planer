# Vorlage für die Konfiguration. Kopieren nach .env und Werte eintragen.
# Echte Geheimnisse gehören NUR in .env auf dem Server, nie ins Repository.

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=planer.example.org
DJANGO_DEBUG=false
# Pfad zum Django-Admin (nur für den Betreiber) – gern etwas schwer zu Erratendes
DJANGO_ADMIN_URL=admin/
# Django-Admin nur mit Zwei-Faktor-Anmeldung (dringend empfohlen)
DJANGO_ADMIN_REQUIRE_2FA=true

# Domain (für Caddy / HTTPS)
DOMAIN=planer.example.org
# Adresse für Links in E-Mails (Standard: https://<erster Eintrag von DJANGO_ALLOWED_HOSTS>)
SITE_URL=https://planer.example.org
# Kontakt für Let's Encrypt (Ablauf-Hinweise zum Zertifikat)
ACME_EMAIL=admin@example.org

# Datenbank (PostgreSQL)
POSTGRES_DB=technik_ag_planer
POSTGRES_USER=technik_ag_planer
POSTGRES_PASSWORD=
# Passwort hier identisch zu POSTGRES_PASSWORD eintragen
DATABASE_URL=postgres://technik_ag_planer:CHANGE_ME@db:5432/technik_ag_planer

# Redis (Warteschlange und Cache)
REDIS_URL=redis://cache:6379/0
# Optional, Standard ist REDIS_URL
# CELERY_BROKER_URL=redis://cache:6379/1

# E-Mail (SMTP) – nur für Einladungen und „Passwort vergessen“
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.org

# Google (OAuth 2.0 für Drive und Kalender) – Anleitung: docs/installation/google-cloud.md
# Weiterleitungs-URL im Google-Cloud-Projekt: <SITE_URL>/einstellungen/google/rueckmeldung/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Höchstgröße für Datei-Uploads in MB (Standard 25)
# GOOGLE_UPLOAD_MAX_MB=25

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
